<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to talk to the trip-tracker API, and to fetch map tiles. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- osmdroid checks connectivity before reaching for a tile, so that a
         phone with no signal draws its cache instead of stalling. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading a trip's invite QR code. Requested at the moment the scanner
         screen opens, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A phone without a camera can still do everything else, so this is not
         a reason for Play to hide the app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Location sharing. Fine is what the map is worth showing; coarse is
         accepted because Android lets a rider grant only that. Both are
         requested at the moment sharing is first started, never at launch. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Reading location with the phone in a pocket means a foreground
         service, and from Android 14 a service that reads location must
         declare this alongside its type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Doze and app-standby throttle a backgrounded app even when it runs a
         foreground service: a reporting loop on a 45-second beat quietly
         becomes one every few minutes, which on a long ride is the rider
         watching their own pin stop moving. This permission is what allows
         the standard system dialog to be shown; the exemption itself is
         always the rider's to give, and it is asked for once, at the moment
         sharing first starts. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The tracking notification is how a rider knows their location is going
         out, and how they stop it. Without this grant on Android 13+ the
         service still runs but its notification is hidden, so it is asked for
         together with location. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TracktripApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tracktrip">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tracktrip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invite links. The app's own scheme always works; the https
                 form is what goes into a message, so a phone without the app
                 installed has somewhere to land once ptrip.app serves that
                 path.

                 pathPattern rather than pathPrefix: a prefix of "/join" also
                 claims /joining, /joinus and anything else the site may want
                 that word for later, and it claims the bare /join, which
                 carries no code to act on. "/join/.*" is the shape an invite
                 actually has. The syntax is Android's simplified glob, not a
                 regex — "." is any character and "*" is zero or more of what
                 precedes it — so "/join/.*" reads as /join/ followed by
                 anything, which is what is wanted here.

                 autoVerify makes this a *verified* App Link, which is what
                 opens the app without a chooser and stops another app from
                 claiming the same link. Verification is per package name and
                 per signing certificate, and this filter is in the shared
                 manifest, so it applies to the debug variant too — under its
                 own applicationId, app.ptrip.tracktrip.debug. Both have to be
                 listed in the assetlinks.json served from the domain, or the
                 one that is missing falls back to a chooser. See
                 deploy/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ptrip.app" android:pathPattern="/join/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tracktrip" android:host="join" />
            </intent-filter>
        </activity>

        <service
            android:name=".location.LocationSharingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
