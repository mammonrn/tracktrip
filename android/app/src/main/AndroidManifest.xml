<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to talk to the trip-tracker API. Location and
         foreground-service permissions are deliberately not declared yet —
         they arrive with the tracking phase. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading a trip's invite QR code. Requested at the moment the scanner
         screen opens, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A phone without a camera can still do everything else, so this is not
         a reason for Play to hide the app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tracktrip">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tracktrip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
