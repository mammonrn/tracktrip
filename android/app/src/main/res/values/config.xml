<?xml version="1.0" encoding="utf-8"?>
<!--
  All environment/project configuration for the app lives in this one file.
  Change these values if the Google Cloud project or API host ever changes.

  None of these are secrets — OAuth client IDs are public identifiers, and are
  meant to ship inside the app. The private key that actually proves the app's
  identity is the release keystore, which never enters this repo.
-->
<resources>

    <!--
      WEB client ID. This is the one passed to GetGoogleIdOption as the
      *server* client ID, and the one the backend verifies the ID token
      against (backend .env GOOGLE_CLIENT_ID).

      This is NOT a mistake: Credential Manager wants the Web client ID here,
      not the Android one. The ID token it returns carries this value in its
      `aud` claim, which is what the backend checks.

      TODO: the value below is TRUNCATED and will not work as-is. Replace
      __FILL_IN__ with the rest of the real web client ID from Google Cloud
      Console. The app shows an explicit error instead of signing in while
      the placeholder is still present.
    -->
    <string name="google_web_client_id" translatable="false">471850622906-8erl__FILL_IN__.apps.googleusercontent.com</string>

    <!--
      ANDROID client ID. Recorded here for reference only — it is deliberately
      NOT referenced anywhere in the code.

      The Android OAuth client works by matching the app's package name plus
      the signing certificate SHA-1 fingerprint registered in Google Cloud
      Console. Google checks it automatically; there is no API that takes it.
      If sign-in fails with a "developer error", the usual cause is that the
      package name / SHA-1 pair registered for this client doesn't match the
      build being run (debug builds use applicationIdSuffix ".debug" and the
      debug keystore, so they need their own registration).

      TODO: truncated, same as above — complete it if you rely on this file as
      your record of the project's client IDs.
    -->
    <string name="google_android_client_id" translatable="false">471850622906-lek8__FILL_IN__.apps.googleusercontent.com</string>

    <!-- Base URL of the trip-tracker backend. No trailing slash. -->
    <string name="api_base_url" translatable="false">https://api.ptrip.app</string>

</resources>
