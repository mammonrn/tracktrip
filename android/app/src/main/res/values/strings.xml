    <!-- Battery optimisation -->
    <string name="settings_battery">Background battery use</string>
    <string name="settings_battery_optimised">Restricted</string>
    <string name="settings_battery_unrestricted">Unrestricted</string>
    <string name="settings_battery_optimised_hint">Android may slow this app down while it is in the background, which can hold up your position while you ride. Tap to allow it to run unrestricted.</string>
    <string name="settings_battery_unrestricted_hint">Android will let PTrips keep reporting while you ride with the screen off.</string>
    <!--
      The second battery killer, the one Android's own exemption does not
      cover. Written as a path to follow rather than linked to: the intents
      that open these screens are undocumented and change between skin
      versions, so a button would work on one phone and throw on the next.
      Each string uses the words that maker actually prints on the screen.
    -->
    <string name="settings_battery_vendor_title">Your phone has an extra setting</string>
    <string name="settings_battery_vendor_samsung">Samsung puts unused apps to sleep on its own, separately from Android. Go to Settings › Battery › Background usage limits, and make sure PTrips is not in "Sleeping apps" or "Deep sleeping apps". Adding it to "Never sleeping apps" is the surest way.</string>
    <string name="settings_battery_vendor_xiaomi">Xiaomi phones stop apps that are not set to autostart. Go to Settings › Apps › Manage apps › PTrips, turn on "Autostart", then open "Battery saver" on the same screen and choose "No restrictions".</string>
    <string name="settings_battery_vendor_oppo">Go to Settings › Battery › Power saving options (or App battery management) › PTrips, and allow "Background running" and "Auto-launch". ColorOS stops background apps on its own otherwise.</string>
    <string name="settings_battery_vendor_realme">Go to Settings › Battery › App battery management › PTrips, and allow "Background running" and "Auto-launch". Realme UI stops background apps on its own otherwise.</string>
    <string name="settings_battery_vendor_vivo">Go to Settings › Battery › Background power consumption management › PTrips and allow it to run in the background. Also turn on "Auto-start" for PTrips under Settings › Apps.</string>
    <string name="settings_battery_vendor_oneplus">Go to Settings › Battery › Battery optimisation › PTrips and choose "Don\'t optimise". On OxygenOS 12 and later, also turn off "Deep optimisation" and "Sleep standby optimisation" under Advanced settings.</string>
    <string name="settings_battery_vendor_huawei">Go to Settings › Battery › App launch, turn off "Manage automatically" for PTrips, then allow "Auto-launch", "Secondary launch" and "Run in background".</string>

    <!-- Map -->
    <string name="map_title">Live map</string>
    <string name="map_riders_placed">%1$d of %2$d riders on the map</string>
    <string name="map_center_on_me">Centre on me</string>
    <!--
      The overview control and the bar down the edge of the map. The bar's
      caption says "straight line" because that is what it measures: the app
      has no routing engine, and a bar that implied it knew the road would be
      wrong by however much the road bends.
    -->
    <string name="map_overview">See the whole route</string>
    <string name="map_progress_straight_line">direct</string>
    <!--
      The same bar, when the server managed to fetch a road route: the number
      above it is then road distance measured along that route, not the gap to
      the finish. The two are wildly different on a mountain road, so which one
      is on screen is said rather than left to be guessed.
    -->
    <string name="map_progress_by_road">by road</string>
    <!--
      The trail toggle. Worded as what pressing it does, not as what is
      currently true, because it is an icon button with no label beside it.
    -->
    <string name="map_trails_show">Show where everyone has been</string>
    <string name="map_trails_hide">Hide where everyone has been</string>
    <string name="map_no_position">No position yet</string>
    <string name="map_last_seen">Last known position</string>
    <string name="map_you">%1$s (you)</string>
    <string name="map_no_location">Couldn\'t work out where you are. Check that location is on.</string>
    <string name="map_speed_kmh">%1$d km/h</string>
    <!-- No speed to show: an older build, or a fix whose provider had none. -->
    <string name="map_speed_unknown">—</string>
    <string name="map_own_speed">Your speed</string>
    <!--
      When this phone last had a report accepted. Shown only while sharing.
      The service has always recorded it and nothing showed it, which made a
      ride where positions stopped landing look exactly like one where they
      landed and the screen failed to draw them.
    -->
    <string name="map_reported_now">Sent just now</string>
    <string name="map_reported_minutes">Sent %1$d min ago</string>
    <!--
      How old a rider's last reported position is. Shown because positions
      arrive on a cadence rather than continuously: a pin that has not moved
      is usually correct, and without this it is indistinguishable from a
      dead app.
    -->
    <string name="map_fix_age_now">just now</string>
    <string name="map_fix_age_minutes">%1$d min ago</string>
    <!--
      The list order is worked out from which way the group is heading, not
      from distance along a road — the app has no route to measure against.
      The row says so, because a bare "in front first" would read as a fact.
    -->
    <!-- Under a start/finish flag whose coordinate was set without a name. -->
    <string name="map_origin">Start</string>
    <string name="map_destination">Finish</string>
    <string name="map_order_leader_first">In front first · estimated from heading</string>

