    <!--
      Finding a place by name instead of hunting for it on the map. An
      addition to the long press, never a replacement: the long press is the
      only one that works for a spot with no name, and the only one that works
      at all on a server with no search key configured.
    -->
    <string name="map_search_places">Search for a place</string>
    <string name="map_search_label">Search for a place</string>
    <string name="map_search_placeholder">Town, road, petrol station…</string>
    <string name="map_search_empty">No place by that name.</string>
    <!--
      The shortcut pinned above the results. Most points a rider places are
      where they already are, and the phone has that coordinate already — no
      typing, no waiting, and nothing taken out of the day's search quota.
      The two unavailable cases are worded apart because one is a permission
      the rider can grant and the other is a fix nobody can hurry.
    -->
    <string name="map_search_use_my_location">Use my current location</string>
    <string name="map_search_location_no_permission">Location access is off, so there\'s no position to use.</string>
    <string name="map_search_location_no_fix">Still looking for your position — give it a moment.</string>
    <!--
      Why a search failed, worded from the cause rather than from the HTTP
      status. The generic wording for a 404 is "That's no longer there.",
      which on a search box reads as a place that has closed down — while what
      a 404 on this route actually means is that the server has no search on
      it at all. The two "not working here" cases stay apart because they have
      different fixes and the reader is often the one who applies them.
    -->
    <string name="map_search_not_deployed">Place search isn\'t on this server yet — its backend is older than this app. Nothing to retry; the server needs updating.</string>
    <string name="map_search_not_configured">Place search isn\'t switched on for this server yet (no API key). Pressing and holding the map still works.</string>
    <string name="map_search_too_many">Too many searches just now. Wait a moment and try again.</string>
    <string name="map_search_upstream">The place search service didn\'t answer. Try again in a moment.</string>
    <string name="map_search_offline">Can\'t reach the server. Check your connection.</string>
    <string name="map_search_failed">Couldn\'t search for places just now.</string>
    <!-- The clear button inside the search field. A glyph, so not translated. -->
    <string name="map_search_clear_symbol" translatable="false">✕</string>

