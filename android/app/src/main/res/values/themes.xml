<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark, and with the HUD background painted on the window itself.

      This is the theme the system uses for the window before Compose has
      drawn anything; on the light parent it showed a white flash on every
      cold start, straight into a near-black app.

      The colour is duplicated from Theme.kt on purpose — a Compose Color is
      not reachable from a resource file — so the two have to be changed
      together. It is the only copy of it outside that file.
    -->
    <style name="Theme.Tracktrip" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hud_background</item>
        <item name="android:colorBackground">@color/hud_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
