# Address the Express + WebSocket server binds to. Keep this as 127.0.0.1 in
# production: the app is reached through nginx on the same host, so binding to
# loopback keeps the port unreachable from the internet directly (no bypassing
# nginx or TLS). Use 0.0.0.0 only if you deliberately need external access.
HOST=127.0.0.1

# Port the Express + WebSocket server listens on.
# Pick a port that doesn't collide with other Node apps already running on the VPS.
PORT=4100

# Secret used to sign/verify JWTs issued to the Android app.
JWT_SECRET=change-me-to-a-long-random-string

# OAuth client ID(s) used to verify Google Sign-In tokens (the ID token's `aud` claim
# must match one of these). Supports multiple client IDs (e.g. a web client used for
# server-side testing plus the Android client) as a comma-separated list.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# Path to the SQLite database file.
DB_PATH=./data/trip-tracker.db

# How many days of position_history to keep for ended trips before `npm run cleanup` deletes them.
HISTORY_RETENTION_DAYS=30
